# Streamlit Secrets Configuration Template
# Copy this file to 'secrets.toml' locally (DO NOT commit secrets.toml to git)
# For Streamlit Cloud: Add these via the Secrets Management UI

# Example: API Keys
# [api_keys]
# openai_api_key = "your-api-key-here"
# google_maps_key = "your-maps-key-here"

# Example: Database Credentials
# [database]
# host = "localhost"
# port = 5432
# username = "uidai_user"
# password = "your-secure-password"

# Example: Custom Configuration
# [app_config]
# max_upload_size_mb = 200
# enable_analytics = true
# admin_email = "admin@example.com"

# Note: Currently, this app doesn't require any secrets for basic functionality
# Add secrets here as needed for future features
